---
import "../styles/global.css";
import content from "../../public/data/content.json";
const { title, description } = Astro.props;
const baseUrl = content.baseUrl;
const deploymentHost = process.env.VERCEL_URL;
const assetOrigin = deploymentHost ? `https://${deploymentHost}` : baseUrl;
const socialImageUrl = `${assetOrigin}/social-preview-arch-v1.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10263B" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- SEO Meta Tags -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={`${baseUrl}${Astro.url.pathname}`} />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${baseUrl}${Astro.url.pathname}`} />
    <meta
      property="og:image"
      content={socialImageUrl}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="Beis Knesses of New Milford — New Milford, NJ"
    />
    <meta property="og:site_name" content={content.home.title} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={socialImageUrl}
    />
    <meta
      name="twitter:image:alt"
      content="Beis Knesses of New Milford — New Milford, NJ"
    />

    <!-- Favicon and App Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={content.home.title} />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Sitemap -->
    <link
      rel="sitemap"
      type="application/xml"
      href={`${baseUrl}/sitemap.xml`}
    />
  </head>
  <body>
    <!-- Zeffy Banner -->
    <div
      id="zeffy-banner"
      class="bg-[#10263B] text-white text-center px-4 py-2.5 border-b border-[#B48A45]/30"
    >
      <p class="text-xs sm:text-sm font-semibold tracking-wide">
        Support our New Building Campaign <span aria-hidden="true">—</span> <a
          href="https://www.zeffy.com/en-US/peer-to-peer/new-building-campaign-2"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#D8B979] underline underline-offset-4 hover:text-white">Donate Now</a
        >
      </p>
    </div>

    <header>
      <slot name="header" />
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <slot name="footer" />
    </footer>
  </body>
</html>
