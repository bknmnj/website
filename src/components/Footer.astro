---
import content from "../../public/data/content.json"; 
const navItems = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/#contact" },
  { name: "Donate", href: "/donate" },
];
---

<footer class="border-t border-[#B48A45]/25 bg-[#10263B] py-14 text-white">
  <div class="container mx-auto px-5 text-center sm:px-6">
    <a href="/" class="inline-block font-serif text-3xl italic hover:text-[#D8B979]">
      {content.home.title}
    </a>
    <ul class="my-9 flex flex-wrap justify-center gap-x-8 gap-y-4">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-xs font-bold uppercase tracking-[0.18em] text-white/75 hover:text-[#D8B979]"
          >{item.name}</a>
        </li>
      ))}
    </ul>
    <p class="border-t border-white/10 pt-7 text-xs uppercase tracking-[0.16em] text-white/50">
      {new Date().getFullYear()} {content.home.title}
    </p>
  </div>
</footer>
