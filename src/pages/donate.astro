---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import content from "../../public/data/content.json";
import { Icon } from "../components/Icons";

const donate = content.donate;
---

<Layout title={donate.title} description={donate.description}>
  <Navbar slot="header" />

  <section class="relative overflow-hidden bg-gradient-to-b from-[#10263B] to-[#0A1D2E] px-5 py-24 text-white sm:px-6 sm:py-28" aria-labelledby="donate-heading">
    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="background-image: radial-gradient(circle at 50% -20%, #B48A45, transparent 45%);"
      aria-hidden="true"
    ></div>
    <div class="container relative z-10 mx-auto text-center">
      <p class="mb-6 inline-block border border-[#B48A45]/50 px-5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-[#D8B979]">
        Support Beis Knesses
      </p>
      <h1 id="donate-heading" class="mx-auto max-w-4xl text-5xl font-semibold italic leading-[0.98] sm:text-6xl lg:text-7xl">
        {donate.title}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg text-white/75 sm:text-xl">{donate.description}</p>
      <a
        href={donate.donateButton.url}
        class="mt-9 inline-flex min-h-12 items-center justify-center gap-3 bg-[#B48A45] px-9 text-sm font-bold uppercase tracking-[0.16em] text-[#10263B] hover:bg-white"
      >
        <Icon name="heart" className="h-5 w-5" /> {donate.donateButton.text}
      </a>
    </div>
  </section>

  <section class="bg-[#F7F2E8] px-5 py-20 sm:px-6 lg:py-28">
    <div class="container mx-auto grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="space-y-8 lg:col-span-5">
        <section class="border-t-4 border-[#B48A45] bg-white p-7 shadow-sm sm:p-9" aria-labelledby="give-heading">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#9A7134]">Make a contribution</p>
          <h2 id="give-heading" class="mt-3 text-4xl font-semibold italic text-[#10263B]">Donate Now</h2>
          <p class="mt-5 leading-relaxed text-[#58636D]">{donate.description}</p>
          <a
            href={donate.donateButton.url}
            class="mt-7 inline-flex min-h-12 w-full items-center justify-center gap-3 bg-[#10263B] px-8 text-center text-sm font-bold uppercase tracking-[0.16em] text-white hover:bg-[#713B42]"
          >
            <Icon name="heart" className="h-5 w-5" /> {donate.donateButton.text}
          </a>
        </section>

        <section class="border border-[#E8DDC8] bg-white p-7 shadow-sm sm:p-9" aria-labelledby="daf-direct-heading">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#9A7134]">Another way to give</p>
          <h2 id="daf-direct-heading" class="mt-3 text-3xl font-semibold italic text-[#10263B]">Donate from a Donor-Advised Fund</h2>
          <p class="mt-4 leading-relaxed text-[#58636D]">
            Recommend a grant through Fidelity Charitable, DAFgiving360, or BNY Mellon.
          </p>
          <div class="mt-7 flex min-h-24 items-center justify-center border border-[#E8DDC8] bg-[#F7F2E8] p-4">
            <script is:inline>
              var _dafdirect_settings = "932165312_1111_08f0e17d-2fa6-4c56-943e-d05ddc477a08";
            </script>
            <script is:inline src="https://www.dafdirect.org/ddirect/dafdirect4.js"></script>
          </div>
        </section>

        <section class="border-t-4 border-[#B48A45] bg-[#10263B] p-7 text-white shadow-lg sm:p-9" aria-labelledby="membership-heading">
          <h2 id="membership-heading" class="text-4xl font-semibold italic">{donate.membership.title}</h2>
          <p class="mt-5 leading-relaxed text-white/72">{donate.membership.description}</p>

          <dl class="mt-8 divide-y divide-white/10 border-y border-white/10">
            <div class="flex items-center justify-between gap-5 py-5">
              <dt class="flex items-center gap-3 font-semibold"><Icon name="users" className="h-5 w-5 text-[#D8B979]" /> Operating Membership</dt>
              <dd class="text-xl font-bold text-[#D8B979]">{donate.membership.pricing.operating}</dd>
            </div>
            <div class="flex items-center justify-between gap-5 py-5">
              <dt class="flex items-center gap-3 font-semibold"><Icon name="building" className="h-5 w-5 text-[#D8B979]" /> Building Membership</dt>
              <dd class="text-xl font-bold text-[#D8B979]">{donate.membership.pricing.building}</dd>
            </div>
            <div class="flex items-center justify-between gap-5 py-5">
              <dt class="text-sm font-bold uppercase tracking-[0.16em]">Total</dt>
              <dd class="text-2xl font-bold">{donate.membership.pricing.total}</dd>
            </div>
          </dl>
        </section>
      </div>

      <section class="overflow-hidden border border-[#E8DDC8] bg-white shadow-sm lg:col-span-7" aria-labelledby="membership-form-heading">
        <div class="border-b border-[#E8DDC8] bg-[#F2E9D8] p-7 sm:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#9A7134]">Become a member</p>
          <h2 id="membership-form-heading" class="mt-3 text-4xl font-semibold italic text-[#10263B]">Membership Application</h2>
          <p class="mt-4 text-[#58636D]">{donate.membership.formText}</p>
        </div>
        <iframe
          src={donate.membership.formIframeUrl}
          title="Beis Knesses of New Milford membership application"
          loading="lazy"
          class="block h-[78rem] w-full border-0 sm:h-[92rem]"
        ></iframe>
      </section>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
