---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ContactUs from "../components/ContactUs";
import content from "../../public/data/content.json";

const about = content.about;
const home = content.home;

const principles = [
  {
    title: "Community",
    description: "Building a warm, inclusive community where everyone feels welcome and valued.",
    icon: "community",
  },
  {
    title: "Learning",
    description: "Fostering a love of Torah learning and Jewish education for all ages.",
    icon: "learning",
  },
  {
    title: "Connection",
    description: "Creating meaningful connections to Judaism, tradition, and each other.",
    icon: "connection",
  },
];
---

<Layout
  title={`About ${home.title}`}
  description={`Learn about ${home.title} and ${about.rabbi.name}.`}
>
  <Navbar slot="header" />

  <section class="relative overflow-hidden bg-gradient-to-b from-[#10263B] to-[#0A1D2E] px-5 py-24 text-white sm:px-6 sm:py-32" aria-labelledby="about-heading">
    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="background-image: radial-gradient(circle at 50% -20%, #B48A45, transparent 45%);"
      aria-hidden="true"
    ></div>
    <div class="container relative z-10 mx-auto max-w-5xl">
      <p class="mb-6 inline-block border border-[#B48A45]/50 px-5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-[#D8B979]">
        About Beis Knesses
      </p>
      <h1 id="about-heading" class="max-w-4xl text-5xl font-semibold italic leading-[0.98] sm:text-6xl lg:text-7xl">
        Our Mission &amp; Vision
      </h1>
      <p class="mt-8 max-w-4xl text-lg leading-relaxed text-white/78 sm:text-xl">
        {about.description}
      </p>
    </div>
  </section>

  <section class="border-b border-[#E8DDC8] bg-[#F7F2E8] px-5 py-20 sm:px-6 lg:py-28" aria-labelledby="principles-heading">
    <div class="container mx-auto">
      <div class="mb-12 max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#9A7134]">The life of our kehillah</p>
        <h2 id="principles-heading" class="mt-3 text-4xl font-semibold italic text-[#10263B] sm:text-5xl">Prayer, learning, and belonging</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {principles.map((principle) => (
          <article class="border border-[#E8DDC8] bg-white p-8 shadow-sm sm:p-10">
            <div class="flex h-14 w-14 items-center justify-center border border-[#B48A45]/45 bg-[#F7F2E8] text-[#9A7134]" aria-hidden="true">
              {principle.icon === "community" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-7 w-7" stroke-width="1.7"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
              )}
              {principle.icon === "learning" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-7 w-7" stroke-width="1.7"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5Z" /></svg>
              )}
              {principle.icon === "connection" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-7 w-7" stroke-width="1.7"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z" /></svg>
              )}
            </div>
            <h3 class="mt-7 text-3xl font-semibold italic text-[#10263B]">{principle.title}</h3>
            <p class="mt-4 leading-relaxed text-[#58636D]">{principle.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-[#E8DDC8] px-5 py-24 sm:px-6 lg:py-32" aria-labelledby="leadership-heading">
    <div class="container mx-auto grid items-center gap-14 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-20">
      <div class="relative mx-auto w-full max-w-md">
        <div class="absolute -inset-3 rotate-2 border border-[#B48A45]/45 sm:-inset-4" aria-hidden="true"></div>
        <div class="relative aspect-[4/5] overflow-hidden border border-[#B48A45]/45 bg-white">
          <img src={about.rabbi.image} alt={about.rabbi.name} class="h-full w-full object-cover" />
        </div>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#8A642D]">Our Leadership</p>
        <h2 id="leadership-heading" class="mt-3 text-5xl font-semibold italic leading-tight text-[#10263B] sm:text-6xl">
          {about.rabbi.name}
        </h2>
        <p class="mt-7 text-lg leading-relaxed text-[#39434B]">{about.rabbi.bio}</p>
        <p class="mt-7 text-[#39434B]">
          {about.rabbi.name} can be reached at
          <a href={`mailto:${about.rabbi.email}`} class="font-semibold text-[#713B42] underline decoration-[#B48A45] underline-offset-4 hover:text-[#10263B]">{about.rabbi.email}</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="bg-[#F7F2E8] px-5 py-24 sm:px-6 lg:py-32">
    <ContactUs
      client:load
      address={home.contact.address}
      phone={home.contact.phone}
      email={home.contact.email}
    />
  </section>

  <Footer slot="footer" />
</Layout>
