---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Zmanim from "../components/Zmanim";
import ShabbatSchedule from "../components/ShabbatSchedule";
import ContactUs from "../components/ContactUs";
import content from "../../public/data/content.json";

const home = content.home;
---

<Layout title={home.title} description="New Milford, NJ">
  <Navbar slot="header" />

  <section class="relative overflow-hidden bg-gradient-to-b from-[#10263B] to-[#0A1D2E] px-5 pb-24 pt-24 text-white sm:px-6 sm:pt-32">
    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="background-image: radial-gradient(circle at 50% -20%, #B48A45, transparent 45%);"
      aria-hidden="true"
    ></div>

    <div class="container relative z-10 mx-auto text-center">
      <p class="mx-auto mb-7 inline-block border border-[#B48A45]/50 px-5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-[#D8B979]">
        {home.title}
      </p>
      <h1 class="mx-auto max-w-4xl text-5xl font-semibold italic leading-[0.98] sm:text-6xl lg:text-7xl">
        A Vibrant Kehillah for Prayer, Learning &amp; Connection
      </h1>
      <p class="mx-auto mb-10 mt-7 max-w-2xl text-lg leading-relaxed text-white/75 sm:text-xl">
        Under the auspices of Rav Yosef Weinberger, our goal is to create a warm,
        friendly and welcoming makom Torah/tefillah.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/donate"
          class="inline-flex min-h-12 items-center justify-center bg-[#B48A45] px-9 text-sm font-bold uppercase tracking-[0.16em] text-[#10263B] hover:bg-white"
        >Donate</a>
        <a
          href="mailto:info@bknm.org"
          class="inline-flex min-h-12 items-center justify-center border border-white/35 px-9 text-sm font-bold uppercase tracking-[0.16em] text-white hover:border-white hover:bg-white/10"
        >Contact</a>
      </div>
    </div>

    <div id="shabbat-schedule" class="container relative z-10 mx-auto mt-24 grid grid-cols-1 gap-8 lg:grid-cols-2">
      <Zmanim client:load />
      <ShabbatSchedule client:load />
    </div>
  </section>

  <section class="overflow-hidden bg-[#E8DDC8] px-5 py-24 sm:px-6 lg:py-32" aria-labelledby="campaign-heading">
    <div class="container mx-auto grid items-center gap-16 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-[#9A7134]">
          Support our New Building Campaign
        </p>
        <h2 id="campaign-heading" class="max-w-xl text-5xl font-semibold italic leading-tight text-[#10263B] sm:text-6xl">
          Help Our Shul Scale and Grow
        </h2>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-[#39434B]">
          Building membership supports the shul's efforts to establish and sustain
          a physical location to allow the shul to scale and grow.
        </p>
        <a
          href="/donate"
          class="mt-9 inline-flex min-h-12 items-center justify-center bg-[#10263B] px-9 text-sm font-bold uppercase tracking-[0.16em] text-white hover:bg-[#713B42]"
        >Donate Now</a>
      </div>

      <div class="relative mx-auto w-full max-w-xl" aria-hidden="true">
        <div class="absolute inset-0 rotate-2 border border-[#B48A45]/45 sm:-inset-4"></div>
        <div class="relative aspect-[5/4] overflow-hidden border border-[#B48A45]/45 bg-[#F2E9D8]">
          <div
            class="absolute inset-0 opacity-25"
            style="background-image: radial-gradient(circle at 2px 2px, #B48A45 1px, transparent 0); background-size: 24px 24px;"
          ></div>
          <div class="absolute inset-x-[12%] bottom-0 top-[14%] border-2 border-[#B48A45]/50"></div>
          <svg viewBox="0 0 100 120" class="absolute inset-x-0 bottom-0 mx-auto h-[88%] w-auto text-[#10263B]" fill="none">
            <path d="M10 110V40Q50 0 90 40V110" stroke="currentColor" stroke-width="1.5"></path>
            <path d="M25 110V55Q50 30 75 55V110" stroke="#B48A45" stroke-width="1.2"></path>
            <path d="M10 110H90" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="bg-[#F7F2E8] px-5 py-24 sm:px-6 lg:py-32">
    <ContactUs
      client:load
      address={home.contact.address}
      phone={home.contact.phone}
      email={home.contact.email}
    />
  </section>

  <Footer slot="footer" />
</Layout>
